{
  "name": "sift-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Logs-only observability engine: OTLP/HTTP intake, write-ahead log, template mining, Parquet storage, root-cause ranking",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sift": "./dist/surfaces/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sift": "tsx src/surfaces/cli.ts",
    "demo": "tsx src/surfaces/demo.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@duckdb/node-api": "2.0.0-r.1",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "ai": "^7.0.169",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "protobufjs": "^8.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
